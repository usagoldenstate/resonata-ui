# Resonata admin UI — copy to `.env.local` for dev, set in Vercel for prod.

# Base URL of the Resonata FastAPI backend. In dev: http://localhost:8000.
# In prod: your deployed backend domain.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared admin token the backend expects as `X-Admin-Token`. Match the value
# of `ADMIN_TOKEN` in the backend's .env exactly. This is visible in the
# browser — acceptable for a single-operator MVP, not for a public rollout.
NEXT_PUBLIC_ADMIN_TOKEN=

# Feature flags — each page un-wired to the backend is hidden until its
# flag is flipped to the literal string "true". Missing / anything else = hidden.
NEXT_PUBLIC_SHOW_DASHBOARD=false
NEXT_PUBLIC_SHOW_REPORTING=false
NEXT_PUBLIC_SHOW_CALL_LOG=false
NEXT_PUBLIC_SHOW_FAQS=false
