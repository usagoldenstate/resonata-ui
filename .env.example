# Resonata admin UI — copy to `.env.local` for dev, set in Vercel for prod.

# Base URL of the Resonata FastAPI backend. In dev: http://localhost:8000.
# In prod: your deployed backend domain.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared admin token the backend expects as `X-Admin-Token`. Match the value
# of `ADMIN_TOKEN` in the backend's .env exactly. This is visible in the
# browser — acceptable for a single-operator MVP, not for a public rollout.
NEXT_PUBLIC_ADMIN_TOKEN=

# Feature flags — set a flag to the literal string "true" to expose that page.
# Missing / anything else = hidden.
NEXT_PUBLIC_SHOW_DASHBOARD=true
NEXT_PUBLIC_SHOW_REPORTING=true
NEXT_PUBLIC_SHOW_CALL_LOG=true
NEXT_PUBLIC_SHOW_FAQS=true

# "Ask Insights" reporting chat page. Off by default — requires
# NEXT_PUBLIC_SHOW_REPORTING=true as well (nested under Reporting), and the
# backend's own REPORTING_CHAT_ENABLED must also be true or the API 404s.
NEXT_PUBLIC_SHOW_REPORTING_CHAT=false
